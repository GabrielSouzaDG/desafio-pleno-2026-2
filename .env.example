# Copie para .env se quiser sobrescrever algo. Tudo tem default no compose.

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin

PG_USER=app
PG_PASSWORD=app
PG_DATABASE=crm

API_KEY=desafio-2026

# FLAKY_RATE=0 desliga os erros 503 intermitentes.
# Use isso APENAS para depurar. A entrega tem que funcionar com o valor padrao.
FLAKY_RATE=0.02
RATE_LIMIT_RPS=10

# ---------------------------------------------------------------------------
# Portas no SEU host. Mude aqui se alguma ja estiver ocupada.
# Conflito em 8080 e 5432 e comum. Dentro dos containers nada muda.
# ---------------------------------------------------------------------------
# TRINO_PORT=8085
# PG_PORT=55432
# API_PORT=8000
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ICEBERG_REST_PORT=8181
# JUPYTER_PORT=8888
# SPARK_UI_PORT=4041
# THRIFT_PORT=10000
# AIRFLOW_PORT=8081
#
# Descobrir quem ocupa uma porta:
#   docker ps --format '{{.Names}}\t{{.Ports}}' | grep 8080
#   ss -ltnp | grep :8080
#
# ---------------------------------------------------------------------------
# Endpoints: atencao a diferenca entre rodar DE DENTRO e DE FORA dos containers
# ---------------------------------------------------------------------------
# de fora (seu terminal / sua IDE):
#   MinIO      http://localhost:9000
#   Postgres   localhost:5432
#   Mock API   http://localhost:8000
#   Trino      http://localhost:8080
#
# de dentro (Spark, Airflow, outro container):
#   MinIO      http://minio:9000
#   Postgres   postgres:5432
#   Mock API   http://mock-api:8000
#   Trino      trino:8080
